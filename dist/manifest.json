{
  "manifest_version": 3,
  "name": "Judol Detector",
  "version": "1.0.0",
  "description": "Deteksi konten judi online menggunakan KMP, Boyer-Moore, dan RegEx",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/detective.png",
      "48": "icons/detective.png",
      "128": "icons/detective.png"
    }
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-loader-a0qhXJ64.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/detective.png",
    "48": "icons/detective.png",
    "128": "icons/detective.png"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "tesseract/*",
        "tesseract/core/*",
        "assets/chunk-jRWAZmH_.js",
        "assets/content.ts-DActSCYU.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
